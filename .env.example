# 复制为 .env 后填写；.env 不要提交到版本库
TRADEDESK_ENV=dev
TRADEDESK_DB_PATH=data/tradedesk.db
# 生产形态：PostgreSQL + pgvector（Docker 内）
# TRADEDESK_DATABASE_URL=postgresql://tradedesk:tradedesk_local_dev@127.0.0.1:5433/tradedesk
# TRADEDESK_REDIS_URL=redis://127.0.0.1:6380/0

# 云端大模型 / 嵌入（MiniMax）
TRADEDESK_LLM_PROVIDER=minimax
TRADEDESK_LLM_MODEL=MiniMax-Text-01
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
TRADEDESK_LLM_TIMEOUT_S=30

# 检索（PRD 13.4.5 选型轴③）
# 嵌入开关：填了 key 才开；应用启动只**读**现成索引（不计费），建索引是显式动作：dev.ps1 index
TRADEDESK_EMBEDDER_ENABLED=1
# 本机无 GPU 且 Docker Hub 不可达 → 使用云端嵌入（embo-01）而非 PRD 原定的本地 BGE-M3
TRADEDESK_EMBEDDING_MODEL=embo-01
TRADEDESK_EMBEDDING_DIM=1536
TRADEDESK_EMBEDDER_BATCH_SIZE=16
TRADEDESK_RERANKER_MODEL=bge-reranker-v2-m3
# 知识库版本号的唯一真源在 src/tradedesk/data/kb_seed.py，不要在这里写字面量
# TRADEDESK_KB_VERSION=kb-2026.11-c
TRADEDESK_LIST_VERSION=sanctions-2026.11-a

# 业务阈值
TRADEDESK_LOW_CONFIDENCE_THRESHOLD=0.55
TRADEDESK_AMOUNT_THRESHOLD_USD=5000
TRADEDESK_GATE_TOKEN_TTL_S=900

# 并发 / 服务（S2 起使用）
TRADEDESK_MAX_CONCURRENCY=4
TRADEDESK_HOST=127.0.0.1
TRADEDESK_PORT=8080
